<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: Zugriff auf die SQLite-Datenbank ueber HTTP komplett verbieten. -->
<configuration>
  <system.webServer>
    <security>
      <authorization>
        <deny users="*" />
      </authorization>
    </security>
    <handlers>
      <clear />
    </handlers>
  </system.webServer>
</configuration>
